# GEO 品牌诊断系统
# Python backend + React frontend (single service)

[schema]
schemaVersion = 1

[build]
builder = "nixpacks"

[deploy]
startCommand = "cd backend && pip install -r requirements.txt && cp -r ../frontend/dist static && uvicorn main:app --host 0.0.0.0 --port $PORT"
restartPolicyType = "on_failure"
restartPolicyMaxRetries = 3

[env]
PORT = "8900"
